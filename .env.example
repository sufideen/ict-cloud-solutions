# ============================================================
# ICT Cloud Solutions — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Local AI mode ─────────────────────────────────────────────
# Set to "true" to bypass Supabase Edge Functions and call the
# AI provider directly through the Vite dev-server proxy.
# Use this for local development before Edge Functions are deployed.
# In production this must be "false" (or absent).
VITE_LOCAL_AI=false

# ── Azure OpenAI (local dev proxy — server-side only) ─────────
# Read by vite.config.js to configure the /api/azure/* dev proxy.
# These are NOT prefixed with VITE_ so they are NEVER exposed to
# the browser bundle — the Vite proxy injects the api-key header.
# Also set these as Supabase secrets for Edge Functions in production:
#   supabase secrets set AZURE_OPENAI_ENDPOINT=... etc.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── OpenAI (alternative — for when you switch from Azure) ─────
# If switching to standard OpenAI, set these as Supabase secrets
# and update the Edge Functions to use api.openai.com.
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_EMBED_MODEL=text-embedding-3-large

# ── App ───────────────────────────────────────────────────────
VITE_APP_DOMAIN=ict-cloud.solutions
VITE_APP_ENV=development
