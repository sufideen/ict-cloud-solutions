# ============================================================
# ICT Cloud Solutions — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── OpenAI (server-side only — set as Supabase secrets) ──────
# These are used exclusively by Edge Functions and must NEVER
# be added to .env or exposed in the frontend bundle.
# Set them with: supabase secrets set OPENAI_API_KEY=sk-...
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-large

# ── App ───────────────────────────────────────────────────────
VITE_APP_DOMAIN=ict-cloud.solutions
VITE_APP_ENV=development
